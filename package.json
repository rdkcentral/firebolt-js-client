{
  "name": "firebolt-generator",
  "version": "0.1.0",
  "description": "Canonical AST generator for Firebolt 9 API headers",
  "main": "dist/cli.js",
  "bin": {
    "firebolt-gen": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "generate": "ts-node src/cli.ts generate",
    "test": "node --experimental-vm-modules node_modules/.bin/jest"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@open-rpc/schema-utils-js": "^1.16.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/src/**/*.test.ts"]
  }
}
