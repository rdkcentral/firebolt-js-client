    <td class=3D"highlight-#e3fcef confluenceTd" data-highlight-colour=3D"#=
e3fcef">
     <p title=3D""><span style=3D"color:#172b4d;">onStateChanged</span></p>=
</td>
    <td class=3D"highlight-#e3fcef confluenceTd" data-highlight-colour=3D"#=
e3fcef">
     <p title=3D"">List, of length one, of the lifecycle state change</p>
     <ul style=3D"text-align: left;" title=3D"">
