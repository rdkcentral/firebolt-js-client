     <p style=3D"text-align: left;" title=3D"">enum</p>
     <ul style=3D"text-align: left;" title=3D"">
      <li data-uuid=3D"f26cc7fa-61b9-4bf4-8a3e-ad776d73e218">initializing</=
li>
      <li data-uuid=3D"1f621c00-a588-4edb-a984-11aa0e26d393">active</li>
      <li data-uuid=3D"e45c5fb1-87f3-408a-8b79-900c2469218f">paused</li>
      <li data-uuid=3D"93bbe2c0-1694-40b9-908a-6286add4e47d">suspended</li>
      <li data-uuid=3D"976c3e0f-5952-4f9b-a277-5bad1274b832">hibernated</li=
>
      <li data-uuid=3D"bb0eeef4-2889-4767-8d80-fc51405172e4">terminating</l=
i>
     </ul></td>
    <td class=3D"highlight-#e3fcef confluenceTd" data-highlight-colour=3D"#=
e3fcef"><span style=3D"color:#172b4d;" title=3D"">None</span></td>
    <td class=3D"highlight-#e3fcef confluenceTd" style=3D"text-align: cente=
r;" data-highlight-colour=3D"#e3fcef">8.0.0</td>
    <td class=3D"highlight-#e3fcef confluenceTd" style=3D"text-align: cente=
r;" data-highlight-colour=3D"#e3fcef">:tick:</td>
    <td class=3D"highlight-#e3fcef confluenceTd" style=3D"text-align: cente=
r;" data-highlight-colour=3D"#e3fcef">:cross:</td>
    <td class=3D"highlight-#e3fcef confluenceTd" data-highlight-colour=3D"#=
e3fcef">
     <p title=3D""><span style=3D"color:#172b4d;">Returns the current lifec=
ycle state of the app.&nbsp; The first lifecycle state that can be observed=
 by an app/runtime is the initializing state</span></p>
     <p title=3D""><span style=3D"color:#172b4d;">Apps/runtimes should ordi=
narily use state change notifications rather than this method</span></p></t=
d>
   </tr>
   <tr>
