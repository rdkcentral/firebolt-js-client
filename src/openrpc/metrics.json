{
  "openrpc": "1.2.4",
  "info": {
    "title": "Metrics",
    "version": "9.0",
    "x-firebolt-platform": "both",
    "description": "Provides event logging to the platform for metrics and analytics. Apps send telemetry events describing media playback, errors, and lifecycle."
  },
  "methods": [
    {
      "name": "Metrics.ready",
      "summary": "Signal that app is ready.",
      "description": "Signals that the app is ready to display content and accept user input.",
      "params": [],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "appReady",
          "summary": "App is ready",
          "params": [],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.signIn",
      "summary": "Log a sign in event.",
      "description": "Log a sign in event. Platform will automatically detect the id.",
      "params": [],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "x-firebolt-platform": "native",
      "examples": [
        {
          "name": "userSignedIn",
          "summary": "User signed in",
          "params": [],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.signOut",
      "summary": "Log a sign out event.",
      "description": "Log a sign out event. Platform will automatically detect the id.",
      "params": [],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "x-firebolt-platform": "native",
      "examples": [
        {
          "name": "userSignedOut",
          "summary": "User signed out",
          "params": [],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.startContent",
      "summary": "Signal that content playback started.",
      "description": "Signals the app is starting to show video or audio content with entity identification and age policy context.",
      "params": [
        {
          "name": "entityId",
          "required": true,
          "schema": { "type": "string" },
          "description": "Entity identifier for the media asset"
        },
        {
          "name": "agePolicy",
          "required": true,
          "schema": { "$ref": "shared.json#/components/schemas/AgePolicy" },
          "description": "Age policy for the content"
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "contentStarted",
          "summary": "Content playback started",
          "params": [
            { "name": "entityId", "value": "video123" },
            { "name": "agePolicy", "value": "app:adult" }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.stopContent",
      "summary": "Signal that content playback stopped.",
      "description": "Signals the app has stopped showing video or audio content with entity identification and age policy context.",
      "params": [
        {
          "name": "entityId",
          "required": true,
          "schema": { "type": "string" },
          "description": "Entity identifier for the media asset"
        },
        {
          "name": "agePolicy",
          "required": true,
          "schema": { "$ref": "shared.json#/components/schemas/AgePolicy" },
          "description": "Age policy for the content"
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "contentStopped",
          "summary": "Content playback stopped",
          "params": [
            { "name": "entityId", "value": "video123" },
            { "name": "agePolicy", "value": "app:adult" }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.page",
      "summary": "Signal page transition.",
      "description": "Signals that the app has transitioned to a new page with page identification and optional age policy context.",
      "params": [
        {
          "name": "pageId",
          "required": true,
          "schema": { "type": "string" },
          "description": "Identifier for the page the app is now on"
        },
        {
          "name": "agePolicy",
          "required": false,
          "schema": { "$ref": "shared.json#/components/schemas/AgePolicy" },
          "description": "Age policy for content classification"
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "pageTransition",
          "summary": "App navigated to details page",
          "params": [
            { "name": "pageId", "value": "details" }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.error",
      "summary": "Log an error.",
      "description": "Logs an error that occurred within the app with structured error information including type, code, description, visibility, optional parameters, and optional age policy.",
      "params": [
        {
          "name": "type",
          "required": true,
          "schema": { "$ref": "#/components/schemas/ErrorType" },
          "description": "Type of error"
        },
        {
          "name": "code",
          "required": true,
          "schema": { "type": "string" },
          "description": "Error code"
        },
        {
          "name": "description",
          "required": true,
          "schema": { "type": "string" },
          "description": "Human-readable error description"
        },
        {
          "name": "visible",
          "required": true,
          "schema": { "type": "boolean" },
          "description": "Whether error should be visible to user"
        },
        {
          "name": "parameters",
          "required": false,
          "schema": { "type": "object" },
          "description": "Additional error parameters as key-value pairs"
        },
        {
          "name": "agePolicy",
          "required": false,
          "schema": { "$ref": "shared.json#/components/schemas/AgePolicy" },
          "description": "Age policy for content context"
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "networkError",
          "summary": "Network error occurred",
          "params": [
            { "name": "type", "value": "network" },
            { "name": "code", "value": "DNS_FAILED" },
            { "name": "description", "value": "DNS resolution failed" },
            { "name": "visible", "value": true }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.mediaLoadStart",
      "summary": "Signal media load started.",
      "description": "Called when setting the URL of a media asset to play, in order to infer load time.",
      "params": [
        {
          "name": "params",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "Entity identifier for the media asset"
              },
              "agePolicy": {
                "type": "string",
                "description": "Age policy for the content"
              }
            },
            "required": ["entityId"]
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "loadStarted",
          "summary": "Media loading started",
          "params": [
            { "name": "params", "value": { "entityId": "video123" } }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.mediaPlay",
      "summary": "Signal media play began.",
      "description": "Called when media playback should start due to autoplay, user-initiated play, or unpausing.",
      "params": [
        {
          "name": "params",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "Entity identifier for the media asset"
              },
              "agePolicy": {
                "type": "string",
                "description": "Age policy for the content"
              }
            },
            "required": ["entityId"]
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "playStarted",
          "summary": "Playback started",
          "params": [
            { "name": "params", "value": { "entityId": "video123" } }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.mediaPlaying",
      "summary": "Signal media is actively playing.",
      "description": "Called when media playback actually starts due to autoplay, user-initiated play, unpausing, or recovering from a buffering interruption.",
      "params": [
        {
          "name": "params",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "Entity identifier for the media asset"
              },
              "agePolicy": {
                "type": "string",
                "description": "Age policy for the content"
              }
            },
            "required": ["entityId"]
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "mediaActive",
          "summary": "Media actively playing",
          "params": [
            { "name": "params", "value": { "entityId": "video123" } }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.mediaPause",
      "summary": "Signal media was paused.",
      "description": "Signals that media playback has been paused.",
      "params": [
        {
          "name": "params",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "Entity identifier for the media asset"
              },
              "agePolicy": {
                "type": "string",
                "description": "Age policy for the content"
              }
            },
            "required": ["entityId"]
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "mediaPaused",
          "summary": "Playback paused",
          "params": [
            { "name": "params", "value": { "entityId": "video123" } }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.mediaWaiting",
      "summary": "Signal media is buffering.",
      "description": "Signals that media playback is waiting (buffering) for data.",
      "params": [
        {
          "name": "params",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "Entity identifier for the media asset"
              },
              "agePolicy": {
                "type": "string",
                "description": "Age policy for the content"
              }
            },
            "required": ["entityId"]
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "mediaBuffering",
          "summary": "Media is buffering",
          "params": [
            { "name": "params", "value": { "entityId": "video123" } }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.mediaSeeking",
      "summary": "Signal user is seeking.",
      "description": "Signals that the user is seeking to a new playback position with entity identification, target position, and optional age policy.",
      "params": [
        {
          "name": "entityId",
          "required": true,
          "schema": { "type": "string" },
          "description": "Entity identifier for the media asset"
        },
        {
          "name": "target",
          "required": true,
          "schema": { "type": "number", "format": "double" },
          "description": "Target playback position in seconds"
        },
        {
          "name": "agePolicy",
          "required": false,
          "schema": { "$ref": "shared.json#/components/schemas/AgePolicy" },
          "description": "Age policy for content classification"
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "userSeeking",
          "summary": "User initiated seek",
          "params": [
            { "name": "entityId", "value": "video123" },
            { "name": "target", "value": 120.5 }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.mediaSeeked",
      "summary": "Signal seek completed.",
      "description": "Signals that the user has completed seeking to a new position with entity identification, final position, and optional age policy.",
      "params": [
        {
          "name": "entityId",
          "required": true,
          "schema": { "type": "string" },
          "description": "Entity identifier for the media asset"
        },
        {
          "name": "position",
          "required": true,
          "schema": { "type": "number", "format": "double" },
          "description": "Final playback position in seconds"
        },
        {
          "name": "agePolicy",
          "required": false,
          "schema": { "$ref": "shared.json#/components/schemas/AgePolicy" },
          "description": "Age policy for content classification"
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "seekComplete",
          "summary": "Seek operation completed",
          "params": [
            { "name": "entityId", "value": "video123" },
            { "name": "position", "value": 120.5 }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.mediaRateChanged",
      "summary": "Signal playback rate changed.",
      "description": "Signals that media playback rate has changed with entity identification, rate value, and optional age policy.",
      "params": [
        {
          "name": "entityId",
          "required": true,
          "schema": { "type": "string" },
          "description": "Entity identifier for the media asset"
        },
        {
          "name": "rate",
          "required": true,
          "schema": { "type": "number", "format": "double" },
          "description": "Playback rate multiplier (e.g., 2.0 for 2x speed)"
        },
        {
          "name": "agePolicy",
          "required": false,
          "schema": { "$ref": "shared.json#/components/schemas/AgePolicy" },
          "description": "Age policy for content classification"
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "rateChanged",
          "summary": "Playback rate changed",
          "params": [
            { "name": "entityId", "value": "video123" },
            { "name": "rate", "value": 2.0 }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.mediaRenditionChanged",
      "summary": "Signal rendition/quality changed.",
      "description": "Signals that media rendition (quality) has changed with entity identification, bitrate, dimensions, optional profile, and optional age policy.",
      "params": [
        {
          "name": "entityId",
          "required": true,
          "schema": { "type": "string" },
          "description": "Entity identifier for the media asset"
        },
        {
          "name": "bitrate",
          "required": true,
          "schema": { "type": "number" },
          "description": "Bitrate in bits per second"
        },
        {
          "name": "width",
          "required": true,
          "schema": { "type": "number" },
          "description": "Video width in pixels"
        },
        {
          "name": "height",
          "required": true,
          "schema": { "type": "number" },
          "description": "Video height in pixels"
        },
        {
          "name": "profile",
          "required": false,
          "schema": { "type": "string" },
          "description": "Quality profile identifier"
        },
        {
          "name": "agePolicy",
          "required": false,
          "schema": { "$ref": "shared.json#/components/schemas/AgePolicy" },
          "description": "Age policy for content classification"
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "qualityChanged",
          "summary": "Media quality changed to 1080p",
          "params": [
            { "name": "entityId", "value": "video123" },
            { "name": "bitrate", "value": 5000000 },
            { "name": "width", "value": 1920 },
            { "name": "height", "value": 1080 }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.mediaEnded",
      "summary": "Signal media playback ended.",
      "description": "Signals that media playback has ended.",
      "params": [
        {
          "name": "params",
          "required": true,
          "schema": {
            "type": "object",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "Entity identifier for the media asset"
              },
              "agePolicy": {
                "type": "string",
                "description": "Age policy for the content"
              }
            },
            "required": ["entityId"]
          }
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "playbackEnded",
          "summary": "Media playback completed",
          "params": [
            { "name": "params", "value": { "entityId": "video123" } }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.event",
      "summary": "Log a custom event.",
      "description": "Generic event telemetry allowing apps to log custom metrics and analytics events with schema URI, data string, and optional age policy.",
      "params": [
        {
          "name": "schema",
          "required": true,
          "schema": { "type": "string" },
          "description": "Schema URI for the event data format"
        },
        {
          "name": "data",
          "required": true,
          "schema": { "type": "string" },
          "description": "Event data as a string"
        },
        {
          "name": "agePolicy",
          "required": false,
          "schema": { "$ref": "shared.json#/components/schemas/AgePolicy" },
          "description": "Age policy for content classification"
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "customEvent",
          "summary": "Custom analytics event",
          "params": [
            { "name": "schema", "value": "http://example.com/schema/custom-event" },
            { "name": "data", "value": "{\"action\":\"favorite\",\"contentId\":\"123\"}" }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    },
    {
      "name": "Metrics.appInfo",
      "summary": "Send app-specific metrics.",
      "description": "Sends app-specific metrics to the platform with a build identifier.",
      "params": [
        {
          "name": "build",
          "required": true,
          "schema": { "$ref": "#/components/schemas/BuildInfo" },
          "description": "Build identifier for the app"
        }
      ],
      "result": {
        "name": "result",
        "schema": { "type": "null" }
      },
      "examples": [
        {
          "name": "appInfoWithBuild",
          "summary": "App info with build identifier",
          "params": [
            { "name": "build", "value": { "build": "1.2.3" } }
          ],
          "result": { "name": "result", "value": null }
        }
      ]
    }
  ],
  "components": {
    "schemas": {
      "ErrorType": {
        "title": "ErrorType",
        "type": "string",
        "enum": ["network", "media", "restriction", "entitlement", "other"],
        "description": "Classification of error type.",
        "examples": ["network"]
      },
      "BuildInfo": {
        "title": "BuildInfo",
        "type": "object",
        "properties": {
          "build": {
            "type": "string",
            "description": "Build identifier for the app"
          }
        },
        "required": ["build"],
        "description": "Build information for the app"
      }
    }
  }
}
