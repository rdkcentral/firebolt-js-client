{
  "openrpc": "1.2.4",
  "info": {
    "title": "VideoOutput",
    "version": "9.0",
    "x-firebolt-platform": "both",
    "description": "Provides access to video output configuration. Apps can query and subscribe to video output resolution changes."
  },
  "methods": [
    {
      "name": "VideoOutput.resolution",
      "summary": "Get the current video output resolution.",
      "description": "Returns the current HDMI output resolution of the device.",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/VideoResolution"
        }
      },
      "examples": [
        {
          "name": "videoOutputResolution",
          "summary": "Device output resolution is 4K",
          "params": [],
          "result": {
            "name": "result",
            "value": "3840x2160"
          }
        }
      ]
    },
    {
      "name": "VideoOutput.onResolutionChanged",
      "summary": "Subscribe to video output resolution changes.",
      "description": "Fired when the video output resolution changes.",
      "params": [
        {
          "name": "listen",
          "required": true,
          "schema": {
            "type": "boolean"
          },
          "description": "Pass true to subscribe; false to unsubscribe"
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/VideoResolution"
        }
      },
      "examples": [
        {
          "name": "resolutionChanged",
          "summary": "Resolution changed to 1080p",
          "params": [],
          "result": {
            "name": "result",
            "value": "1920x1080"
          }
        }
      ]
    },
    {
      "name": "VideoOutput.hdcp",
      "summary": "Get the current HDCP state.",
      "description": "Returns the current state of output protection on the video output. OTT/STB device: returns the negotiated HDCP version on the video output, or none if an encrypted connection has not been made between the OTT/STB device and any attached TV. TV device: returns direct.",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/HdcpType"
        }
      },
      "examples": [
        {
          "name": "hdcpState",
          "summary": "HDCP 2.2 negotiated",
          "params": [],
          "result": {
            "name": "result",
            "value": "hdcp2.2"
          }
        }
      ]
    },
    {
      "name": "VideoOutput.onHdcpChanged",
      "summary": "Subscribe to HDCP state changes.",
      "description": "Event for when VideoOutput.hdcp changed.",
      "params": [
        {
          "name": "listen",
          "required": true,
          "schema": {
            "type": "boolean"
          },
          "description": "Pass true to subscribe; false to unsubscribe"
        }
      ],
      "result": {
        "name": "result",
        "schema": {
          "$ref": "#/components/schemas/HdcpType"
        }
      },
      "examples": [
        {
          "name": "hdcpChanged",
          "summary": "HDCP state changed",
          "params": [],
          "result": {
            "name": "result",
            "value": "hdcp1.4"
          }
        }
      ]
    }
  ],
  "components": {
    "schemas": {
      "VideoResolution": {
        "title": "VideoResolution",
        "type": "string",
        "description": "Video resolution output. The resolution in format WIDTHxHEIGHT.",
        "examples": [
          "3840x2160"
        ]
      },
      "HdcpType": {
        "title": "HdcpType",
        "type": "string",
        "enum": [
          "hdcp1.4",
          "hdcp2.2",
          "none",
          "direct"
        ],
        "description": "HDCP output protection state",
        "examples": [
          "hdcp2.2"
        ]
      }
    }
  }
}