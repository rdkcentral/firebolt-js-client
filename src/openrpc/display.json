{
  "openrpc": "1.2.4",
  "info": {
    "title": "Display",
    "description": "A module for querying about the display",
    "version": "1.0.0"
  },
  "methods": [
    {
      "name": "edid",
      "summary": "Returns the EDID (and extensions) of the connected or integral display, as a Base64-encoded string. Returns an empty string when no HDMI display is connected.",
      "params": [],
      "tags": [
        {
          "name": "rpc-only"
        },
        {
          "name": "capabilities",
          "x-uses": [
            "xrn:firebolt:capability:display:info"
          ]
        }
      ],
      "result": {
        "name": "Base64 EDID",
        "summary": "The EDID (and extensions) of the connected or integral display, as a Base64-encoded string. Returns an empty string when no HDMI display is connected.",
        "schema": {
          "type": "string"
        }
      },
      "examples": [
        {
          "name": "Getting the display EDID",
          "params": [],
          "result": {
            "name": "Default Result",
            "value": "ZWU2NzIzYjgtN2FiMy00NjJjLThkOTMtZGJmNjEyMjc5OThl"
          }
        },
        {
          "name": "No display is connected",
          "params": [],
          "result": {
            "name": "Default Result",
            "value": ""
          }
        }
      ]
    },
    {
      "name": "size",
      "summary": "Returns the physical dimensions of the connected or integral display, in centimeters. Returns 0, 0 when no HDMI display is connected.",
      "params": [],
      "tags": [
        {
          "name": "rpc-only"
        },
        {
          "name": "capabilities",
          "x-uses": [
            "xrn:firebolt:capability:display:info"
          ]
        }
      ],
      "result": {
        "name": "size",
        "summary": "The display size in centimeters",
        "schema": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "description": "The width of the display in centimeters"
            },
            "height": {
              "type": "integer",
              "description": "The height of the display in centimeters"
            }
          }
        }
      },
      "examples": [
        {
          "name": "Get the display size",
          "params": [],
          "result": {
            "name": "Default Result",
            "value": {
              "width": 48,
              "height": 27
            }
          }
        },
        {
          "name": "No display is connected",
          "params": [],
          "result": {
            "name": "Default Result",
            "value": {
              "width": 0,
              "height": 0
            }
          }
        }
      ]
    },
    {
      "name": "maxResolution",
      "summary": "Returns the physical/native resolution of the connected or integral display, in pixels. Returns 0, 0 when no HDMI display is connected.",
      "params": [],
      "tags": [
        {
          "name": "rpc-only"
        },
        {
          "name": "capabilities",
          "x-uses": [
            "xrn:firebolt:capability:display:info"
          ]
        }
      ],
      "result": {
        "name": "maxResolution",
        "summary": "The display resolution",
        "schema": {
          "type": "object",
          "properties": {
            "width": {
              "type": "integer",
              "description": "The width of the display in pixels"
            },
            "height": {
              "type": "integer",
              "description": "The height of the display in pixels"
            }
          }
        }
      },
      "examples": [
        {
          "name": "Get the display max resolution",
          "params": [],
          "result": {
            "name": "Default Result",
            "value": {
              "width": 1920,
              "height": 1080
            }
          }
        },
        {
          "name": "No display is connected",
          "params": [],
          "result": {
            "name": "Default Result",
            "value": {
              "width": 0,
              "height": 0
            }
          }
        }
      ]
    },
    {
      "name": "videoResolutions",
      "summary": "Returns the list of HD video resolutions supported by the connected or integral display, in pixels. Returns an empty list when no HDMI display is connected.",
      "params": [],
      "tags": [
        {
          "name": "capabilities",
          "x-uses": [
            "xrn:firebolt:capability:display:info"
          ]
        }
      ],
      "result": {
        "name": "videoResolutions",
        "summary": "The list of supported HD video resolutions",
        "schema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "width": {
                "type": "integer",
                "description": "The width of the display resolution, in pixels"
              },
              "height": {
                "type": "integer",
                "description": "The height of the display resolution, in pixels"
              }
            }
          }
        }
      },
      "examples": [
        {
          "name": "Return the HD video resolutions on a UHD-capable display",
          "params": [],
          "result": {
            "name": "Default Result",
            "value": [
              {
                "width": 1280,
                "height": 720
              },
              {
                "width": 1920,
                "height": 1080
              },
              {
                "width": 3840,
                "height": 2160
              }
            ]
          }
        },
        {
          "name": "No display is connected",
          "params": [],
          "result": {
            "name": "Default Result",
            "value": []
          }
        }
      ]
    },
    {
      "name": "colorimetry",
      "summary": "Returns the SDR and HDR colorimetry standards supported by the connected or integral display. Returns an empty list when no HDMI display is connected.",
      "params": [],
      "tags": [
        {
          "name": "capabilities",
          "x-uses": [
            "xrn:firebolt:capability:display:info"
          ]
        }
      ],
      "result": {
        "name": "colorimetry",
        "summary": "The supported SDR and HDR colorimetry standards",
        "schema": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "bt709",
              "bt2020"
            ]
          }
        }
      },
      "examples": [
        {
          "name": "Get the supported colorimetry standards from an HDR display",
          "params": [],
          "result": {
            "name": "Default Result",
            "value": [
              "bt709",
              "bt2020"
            ]
          }
        },
        {
          "name": "No display is connected",
          "params": [],
          "result": {
            "name": "Default Result",
            "value": []
          }
        }
      ]
    }
  ]
}
