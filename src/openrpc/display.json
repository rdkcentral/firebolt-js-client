{
  "openrpc": "1.2.4",
  "info": {
    "title": "Display",
    "version": "9.0",
    "x-firebolt-platform": "both",
    "description": "Provides access to display capabilities. Some APIs are web-only, some are native-only, some are both."
  },
  "methods": [
    {
      "name": "Display.colorimetry",
      "summary": "Get the display colorimetry standards.",
      "description": "Returns an unordered list of colorimetry values supported by the attached TV or integral display. Returns an empty list if no TV is attached.",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/ColorimetryValue" }
        }
      },
      "x-firebolt-platform": "web",
      "examples": [
        {
          "name": "displayColorimetry",
          "summary": "Display supports BT.709 and BT.2020",
          "params": [],
          "result": {
            "name": "result",
            "value": ["bt709", "bt2020"]
          }
        }
      ]
    },
    {
      "name": "Display.videoResolutions",
      "summary": "Get the supported video resolutions.",
      "description": "Returns an unordered list of HD video resolutions and frame rates supported by the attached TV or integral display. Returns an empty list if no TV is attached.",
      "params": [],
      "result": {
        "name": "result",
        "schema": {
          "type": "array",
          "items": { "$ref": "#/components/schemas/VideoResolution" }
        }
      },
      "x-firebolt-platform": "web",
      "examples": [
        {
          "name": "displayResolutions",
          "summary": "Display supports 1080p60 and 2160p60",
          "params": [],
          "result": {
            "name": "result",
            "value": ["1080p60", "2160p60"]
          }
        }
      ]
    }
  ],
  "components": {
    "schemas": {
      "ColorimetryValue": {
        "title": "ColorimetryValue",
        "type": "string",
        "enum": ["bt709", "bt2020"],
        "description": "Colorimetry standard.",
        "x-firebolt-platform": "web",
        "examples": ["bt709"]
      },
      "VideoResolution": {
        "title": "VideoResolution",
        "type": "string",
        "enum": ["720p50", "720p60", "1080p50", "1080p60", "2160p50", "2160p60"],
        "description": "HD video resolution and frame rate.",
        "x-firebolt-platform": "web",
        "examples": ["1080p60"]
      }
    }
  }
}
